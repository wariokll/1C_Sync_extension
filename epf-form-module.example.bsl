&НаКлиенте
Процедура ОбработатьТекст(Команда)
    Результат.Очистить();
    ТекстРезультата = ПользовательскийТекст;

    Если ПреобразоватьВВерхнийРегистр Тогда
        ТекстРезультата = ВРег(ТекстРезультата);
    КонецЕсли;

    НоваяСтрока = Результат.Добавить();
    НоваяСтрока.Текст = ТекстРезультата;
КонецПроцедуры