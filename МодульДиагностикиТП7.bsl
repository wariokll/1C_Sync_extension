&НаКлиенте
Процедура ВыполнитьДиагностику(Команда)
    Статус = "Выполняется чтение метаданных...";
    ВыполнитьДиагностикуНаСервере();
    Сообщить(Статус);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультат(Команда)
    РезультатыДиагностики.Очистить();
    Статус = "Результат очищен.";
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДиагностикуНаСервере()
    РезультатыДиагностики.Очистить();
    КоличествоОшибок = 0;

    ДобавитьСведенияОСреде();
    ДобавитьСведенияОПланахОбмена(КоличествоОшибок);
    ДобавитьСведенияОДокументах(КоличествоОшибок);
    ДобавитьСведенияОбОбработках(КоличествоОшибок);
    ДобавитьСведенияОбОбъектахИнтеграции(КоличествоОшибок);
    ДобавитьОграниченияДиагностики();

    Статус = СтрШаблон(
        "Диагностика завершена. Строк: %1, ошибок чтения: %2.",
        РезультатыДиагностики.Количество(),
        КоличествоОшибок);
КонецПроцедуры

&НаСервере
Процедура ДобавитьСведенияОСреде()
    СистемнаяИнформация = Новый СистемнаяИнформация;
    ДобавитьСтроку("Среда", "Платформа", "Версия", СистемнаяИнформация.ВерсияПриложения);
    ДобавитьСтроку("Среда", "Платформа", "Тип платформы", Строка(СистемнаяИнформация.ТипПлатформы));
    ДобавитьСтроку("Конфигурация", Метаданные.Имя, "Синоним", Строка(Метаданные.Синоним));

    Попытка
        ДобавитьСтроку("Конфигурация", Метаданные.Имя, "Версия", Метаданные.Версия);
    Исключение
        ДобавитьСтроку("Конфигурация", Метаданные.Имя, "Версия", "Недоступно: " + ОписаниеОшибки());
    КонецПопытки;

    Попытка
        ДобавитьСтроку("Конфигурация", Метаданные.Имя, "Поставщик", Метаданные.Поставщик);
    Исключение
        ДобавитьСтроку("Конфигурация", Метаданные.Имя, "Поставщик", "Недоступно: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ДобавитьСведенияОПланахОбмена(КоличествоОшибок)
    ДобавитьСтроку("Итоги", "Планы обмена", "Количество", Метаданные.ПланыОбмена.Количество());

    Для Каждого ПланОбменаМетаданные Из Метаданные.ПланыОбмена Цикл
        ИмяПлана = ПланОбменаМетаданные.Имя;
        ДобавитьСтроку("План обмена", ИмяПлана, "Синоним", Строка(ПланОбменаМетаданные.Синоним));
        ДобавитьСтроку("План обмена", ИмяПлана, "Реквизитов", ПланОбменаМетаданные.Реквизиты.Количество());
        ДобавитьСтроку("План обмена", ИмяПлана, "Форм", ПланОбменаМетаданные.Формы.Количество());
        ДобавитьФормыОбъекта("Форма плана обмена", ИмяПлана, ПланОбменаМетаданные.Формы);

        Для Каждого РеквизитМетаданные Из ПланОбменаМетаданные.Реквизиты Цикл
            ДобавитьСтроку(
                "Реквизит плана обмена",
                ИмяПлана + "." + РеквизитМетаданные.Имя,
                "Тип",
                Строка(РеквизитМетаданные.Тип));
        КонецЦикла;

        ДобавитьУзлыПланаОбмена(ИмяПлана, КоличествоОшибок);
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДобавитьУзлыПланаОбмена(ИмяПлана, КоличествоОшибок)
    Попытка
        МенеджерПлана = ПланыОбмена[ИмяПлана];

        Попытка
            ТекущийУзел = МенеджерПлана.ЭтотУзел();
            ДобавитьСтроку("Узел обмена", ИмяПлана, "Этот узел", Строка(ТекущийУзел));
        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            ДобавитьСтроку("Ошибка чтения", ИмяПлана, "Этот узел", ОписаниеОшибки());
        КонецПопытки;

        ВыборкаУзлов = МенеджерПлана.Выбрать();
        КоличествоУзлов = 0;
        Пока ВыборкаУзлов.Следующий() Цикл
            КоличествоУзлов = КоличествоУзлов + 1;
            ДобавитьСтроку("Узел обмена", ИмяПлана, "Узел", Строка(ВыборкаУзлов.Ссылка));
        КонецЦикла;
        ДобавитьСтроку("План обмена", ИмяПлана, "Узлов прочитано", КоличествоУзлов);
    Исключение
        КоличествоОшибок = КоличествоОшибок + 1;
        ДобавитьСтроку("Ошибка чтения", ИмяПлана, "Узлы плана обмена", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ДобавитьСведенияОДокументах(КоличествоОшибок)
    ДобавитьСтроку("Итоги", "Документы", "Количество", Метаданные.Документы.Количество());

    Для Каждого ДокументМетаданные Из Метаданные.Документы Цикл
        Попытка
            ИмяДокумента = ДокументМетаданные.Имя;
            ДобавитьСтроку("Документ", ИмяДокумента, "Синоним", Строка(ДокументМетаданные.Синоним));
            ДобавитьСтроку("Документ", ИмяДокумента, "Реквизитов", ДокументМетаданные.Реквизиты.Количество());
            ДобавитьСтроку("Документ", ИмяДокумента, "Табличных частей", ДокументМетаданные.ТабличныеЧасти.Количество());
            ДобавитьСтроку("Документ", ИмяДокумента, "Форм", ДокументМетаданные.Формы.Количество());
            ДобавитьФормыОбъекта("Форма документа", ИмяДокумента, ДокументМетаданные.Формы);

            Для Каждого РеквизитМетаданные Из ДокументМетаданные.Реквизиты Цикл
                ДобавитьСтроку(
                    "Реквизит документа",
                    ИмяДокумента + "." + РеквизитМетаданные.Имя,
                    "Тип",
                    Строка(РеквизитМетаданные.Тип));
            КонецЦикла;

            Для Каждого ТабличнаяЧастьМетаданные Из ДокументМетаданные.ТабличныеЧасти Цикл
                ПутьТабличнойЧасти = ИмяДокумента + "." + ТабличнаяЧастьМетаданные.Имя;
                ДобавитьСтроку("Табличная часть документа", ПутьТабличнойЧасти, "Колонок", ТабличнаяЧастьМетаданные.Реквизиты.Количество());
                Для Каждого РеквизитТабличнойЧасти Из ТабличнаяЧастьМетаданные.Реквизиты Цикл
                    ДобавитьСтроку(
                        "Реквизит табличной части",
                        ПутьТабличнойЧасти + "." + РеквизитТабличнойЧасти.Имя,
                        "Тип",
                        Строка(РеквизитТабличнойЧасти.Тип));
                КонецЦикла;
            КонецЦикла;
        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            ДобавитьСтроку("Ошибка чтения", "Документы", "Объект", ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДобавитьСведенияОбОбработках(КоличествоОшибок)
    ДобавитьСтроку("Итоги", "Обработки", "Количество", Метаданные.Обработки.Количество());

    Для Каждого ОбработкаМетаданные Из Метаданные.Обработки Цикл
        Попытка
            ИмяОбработки = ОбработкаМетаданные.Имя;
            ДобавитьСтроку("Обработка", ИмяОбработки, "Синоним", Строка(ОбработкаМетаданные.Синоним));
            ДобавитьСтроку("Обработка", ИмяОбработки, "Связана с обменом по имени", ЭтоИмяОбмена(ИмяОбработки));
            ДобавитьФормыОбъекта("Форма обработки", ИмяОбработки, ОбработкаМетаданные.Формы);
        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            ДобавитьСтроку("Ошибка чтения", "Обработки", "Объект", ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДобавитьСведенияОбОбъектахИнтеграции(КоличествоОшибок)
    Попытка
        ДобавитьСтроку("Итоги", "Общие модули", "Количество", Метаданные.ОбщиеМодули.Количество());
        Для Каждого ОбщийМодульМетаданные Из Метаданные.ОбщиеМодули Цикл
            Если ЭтоИмяОбмена(ОбщийМодульМетаданные.Имя) Тогда
                ДобавитьСтроку("Общий модуль обмена", ОбщийМодульМетаданные.Имя, "Синоним", Строка(ОбщийМодульМетаданные.Синоним));
            КонецЕсли;
        КонецЦикла;
    Исключение
        КоличествоОшибок = КоличествоОшибок + 1;
        ДобавитьСтроку("Ошибка чтения", "Общие модули", "Метаданные", ОписаниеОшибки());
    КонецПопытки;

    Попытка
        ДобавитьСтроку("Итоги", "Общие формы", "Количество", Метаданные.ОбщиеФормы.Количество());
        Для Каждого ОбщаяФормаМетаданные Из Метаданные.ОбщиеФормы Цикл
            Если ЭтоИмяОбмена(ОбщаяФормаМетаданные.Имя) Тогда
                ДобавитьСтроку("Общая форма обмена", ОбщаяФормаМетаданные.Имя, "Синоним", Строка(ОбщаяФормаМетаданные.Синоним));
            КонецЕсли;
        КонецЦикла;
    Исключение
        КоличествоОшибок = КоличествоОшибок + 1;
        ДобавитьСтроку("Ошибка чтения", "Общие формы", "Метаданные", ОписаниеОшибки());
    КонецПопытки;

    Попытка
        Для Каждого ОбщаяКомандаМетаданные Из Метаданные.ОбщиеКоманды Цикл
            Если ЭтоИмяОбмена(ОбщаяКомандаМетаданные.Имя) Тогда
                ДобавитьСтроку("Общая команда обмена", ОбщаяКомандаМетаданные.Имя, "Синоним", Строка(ОбщаяКомандаМетаданные.Синоним));
            КонецЕсли;
        КонецЦикла;
    Исключение
        КоличествоОшибок = КоличествоОшибок + 1;
        ДобавитьСтроку("Ошибка чтения", "Общие команды", "Метаданные", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ДобавитьФормыОбъекта(Раздел, ИмяВладельца, ФормыМетаданные)
    Для Каждого ФормаМетаданные Из ФормыМетаданные Цикл
        ДобавитьСтроку(Раздел, ИмяВладельца + "." + ФормаМетаданные.Имя, "Синоним", Строка(ФормаМетаданные.Синоним));
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ЭтоИмяОбмена(ИмяОбъекта)
    ИмяВНижнемРегистре = НРег(Строка(ИмяОбъекта));
    Возврат СтрНайти(ИмяВНижнемРегистре, "обмен") > 0
        Или СтрНайти(ИмяВНижнемРегистре, "синхрон") > 0
        Или СтрНайти(ИмяВНижнемРегистре, "enterprisedata") > 0
        Или СтрНайти(ИмяВНижнемРегистре, "конвертац") > 0
        Или СтрНайти(ИмяВНижнемРегистре, "интеграц") > 0;
КонецФункции

&НаСервере
Процедура ДобавитьОграниченияДиагностики()
    ДобавитьСтроку(
        "Ограничение",
        "Закрытые модули",
        "Экспортные процедуры",
        "Платформа не предоставляет через метаданные перечень процедур модулей. Имена и параметры точки интеграции требуют документации поставщика, журналов или анализа доступной штатной формы.");
    ДобавитьСтроку(
        "Ограничение",
        "Безопасность",
        "Изменение данных",
        "Обработка выполняет только чтение метаданных и узлов планов обмена; запись объектов и запуск обмена отсутствуют.");
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтроку(Раздел, Объект, Свойство, Значение)
    НоваяСтрока = РезультатыДиагностики.Добавить();
    НоваяСтрока.Раздел = Лев(Строка(Раздел), 100);
    НоваяСтрока.Объект = Лев(Строка(Объект), 100);
    НоваяСтрока.Свойство = Лев(Строка(Свойство), 100);
    НоваяСтрока.Значение = Лев(Строка(Значение), 100);
КонецПроцедуры
