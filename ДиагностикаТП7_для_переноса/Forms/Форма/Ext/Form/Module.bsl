// Внешняя обработка «Розничные цены по магазинам ТП7».
// Форма (управляемая):
// Реквизиты формы:
//   ДатаЦен         Дата
//   Магазины        ТаблицаЗначений: Выбран (Булево), Магазин (СправочникСсылка.ТорговыеОбъекты), СкладЦен (СправочникСсылка.Склады)
//   ТипыЦен         ТаблицаЗначений: Выбран (Булево), ТипЦен (СправочникСсылка.ТипыЦен)
//   Результат       ТаблицаЗначений: Магазин (СправочникСсылка.ТорговыеОбъекты), Склад (СправочникСсылка.Склады),
//                   Номенклатура (СправочникСсылка.Номенклатура), Код (Строка),
//                   Характеристика (СправочникСсылка.ХарактеристикиНоменклатуры),
//                   Единица (СправочникСсылка.ЕдиницыИзмерения),
//                   ТипЦен (СправочникСсылка.ТипыЦен), Цена (Число 17.2),
//                   Валюта (СправочникСсылка.Валюты), ДатаУстановки (Дата)
// Команды формы: Сформировать, ВыбратьВсеМагазины, ВыбратьВсеТипыЦен, ВыгрузитьXLSX
// Все таблицы должны быть выведены на форму (Магазины, ТипыЦен, Результат).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ДатаЦен = ТекущаяДата();
    ЗаполнитьСпискиНаСервере();
КонецПроцедуры   

                     
&НаКлиенте
Процедура ПроверитьРегистры(Команда)

    ПроверитьРегистрыНаСервере();

КонецПроцедуры


&НаСервере
Процедура ПроверитьРегистрыНаСервере()

    Для Каждого РегистрМД Из Метаданные.РегистрыСведений Цикл

        Имя = НРег(РегистрМД.Имя);
        Синоним = НРег(РегистрМД.Синоним);

        Если СтрНайти(Имя, "цен") > 0
            Или СтрНайти(Синоним, "цен") > 0
            Или СтрНайти(Имя, "себестоим") > 0
            Или СтрНайти(Синоним, "себестоим") > 0 Тогда

            Сообщить("РегистрСведений."
                + РегистрМД.Имя + " — "
                + РегистрМД.Синоним);

        КонецЕсли;

    КонецЦикла;


    Для Каждого РегистрМД Из Метаданные.РегистрыНакопления Цикл

        Имя = НРег(РегистрМД.Имя);
        Синоним = НРег(РегистрМД.Синоним);

        Если СтрНайти(Имя, "стоим") > 0
            Или СтрНайти(Синоним, "стоим") > 0
            Или СтрНайти(Имя, "товар") > 0
            Или СтрНайти(Синоним, "товар") > 0 Тогда

            Сообщить("РегистрНакопления."
                + РегистрМД.Имя + " — "
                + РегистрМД.Синоним);

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ЗаполнитьСпискиНаСервере()
    Магазины.Очистить();
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   ТО.Ссылка КАК Магазин,
    |   ТО.ОсновнойСкладРозничныхЦен КАК СкладЦен
    |ИЗ Справочник.ТорговыеОбъекты КАК ТО
    |ГДЕ НЕ ТО.ПометкаУдаления И НЕ ТО.ЭтоГруппа
    |УПОРЯДОЧИТЬ ПО ТО.Наименование";
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        СтрокаМагазина = Магазины.Добавить();
        СтрокаМагазина.Выбран = Истина;
        СтрокаМагазина.Магазин = Выборка.Магазин;
        СтрокаМагазина.СкладЦен = Выборка.СкладЦен;
    КонецЦикла;

    ТипыЦен.Очистить();
    Запрос.Текст =
    "ВЫБРАТЬ Типы.Ссылка КАК ТипЦен
    |ИЗ Справочник.ТипыЦен КАК Типы
    |ГДЕ НЕ Типы.ПометкаУдаления И НЕ Типы.ЭтоГруппа
    |УПОРЯДОЧИТЬ ПО Типы.Наименование";
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        СтрокаТипа = ТипыЦен.Добавить();
        СтрокаТипа.Выбран = Ложь; // выбор осознанный: признак «розничный» в справочнике не подтвержден
        СтрокаТипа.ТипЦен = Выборка.ТипЦен;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеМагазины(Команда)
    Для Каждого СтрокаМагазина Из Магазины Цикл
        СтрокаМагазина.Выбран = Истина;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеТипыЦен(Команда)
    Для Каждого СтрокаТипа Из ТипыЦен Цикл
        СтрокаТипа.Выбран = Истина;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
    Попытка
        СформироватьНаСервере();
    Исключение
        Предупреждение("Ошибка получения цен: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
    Результат.Очистить();
    Склады = Новый Массив;
    МагазиныПоСкладам = Новый Соответствие;
    Для Каждого СтрокаМагазина Из Магазины Цикл
        Если НЕ СтрокаМагазина.Выбран Тогда Продолжить; КонецЕсли;
        Если НЕ ЗначениеЗаполнено(СтрокаМагазина.СкладЦен) Тогда
            ВызватьИсключение "Для магазина «" + Строка(СтрокаМагазина.Магазин) + "» не задан ОсновнойСкладРозничныхЦен.";
        КонецЕсли;
        Если Склады.Найти(СтрокаМагазина.СкладЦен) = Неопределено Тогда
            Склады.Добавить(СтрокаМагазина.СкладЦен);
        КонецЕсли;
        // Несколько магазинов могут использовать один склад цен.
        Список = МагазиныПоСкладам.Получить(СтрокаМагазина.СкладЦен);
        Если Список = Неопределено Тогда
            Список = Новый Массив;
            МагазиныПоСкладам.Вставить(СтрокаМагазина.СкладЦен, Список);
        КонецЕсли;
        Список.Добавить(СтрокаМагазина.Магазин);
    КонецЦикла;
    Если Склады.Количество() = 0 Тогда
        ВызватьИсключение "Выберите хотя бы один магазин.";
    КонецЕсли;

    ВыбранныеТипы = Новый Массив;
    Для Каждого СтрокаТипа Из ТипыЦен Цикл
        Если СтрокаТипа.Выбран Тогда ВыбранныеТипы.Добавить(СтрокаТипа.ТипЦен); КонецЕсли;
    КонецЦикла;
    Если ВыбранныеТипы.Количество() = 0 Тогда
        ВызватьИсключение "Выберите хотя бы один тип розничных цен.";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ДатаСреза", КонецДня(ДатаЦен));
    Запрос.УстановитьПараметр("Склады", Склады);
    Запрос.УстановитьПараметр("ТипыЦен", ВыбранныеТипы);
    Запрос.Текст =
    "ВЫБРАТЬ
    |  Цены.Склад КАК Склад,
    |  Цены.Номенклатура КАК Номенклатура,
    |  Цены.Номенклатура.Код КАК Код,
    |  Цены.ХарактеристикаНоменклатуры КАК Характеристика,
    |  Цены.ЕдиницаИзмерения КАК Единица,
    |  Цены.ТипЦен КАК ТипЦен,
    |  Цены.Цена КАК Цена,
    |  Цены.Валюта КАК Валюта,
    |  Цены.Период КАК ДатаУстановки
    |ИЗ РегистрСведений.ЦеныКомпании.СрезПоследних(
    |  &ДатаСреза,
    |  Склад В (&Склады) И ТипЦен В (&ТипыЦен)) КАК Цены
    |УПОРЯДОЧИТЬ ПО Цены.Склад, Цены.Номенклатура.Наименование, Цены.ТипЦен";
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        СписокМагазинов = МагазиныПоСкладам.Получить(Выборка.Склад);
        Если СписокМагазинов = Неопределено Тогда Продолжить; КонецЕсли;
        Для Каждого Магазин Из СписокМагазинов Цикл
            НоваяСтрока = Результат.Добавить();
            НоваяСтрока.Магазин = Магазин;
            НоваяСтрока.Склад = Выборка.Склад;
            НоваяСтрока.Номенклатура = Выборка.Номенклатура;
            НоваяСтрока.Код = Выборка.Код;
            НоваяСтрока.Характеристика = Выборка.Характеристика;
            НоваяСтрока.Единица = Выборка.Единица;
            НоваяСтрока.ТипЦен = Выборка.ТипЦен;
            НоваяСтрока.Цена = Выборка.Цена;
            НоваяСтрока.Валюта = Выборка.Валюта;
            НоваяСтрока.ДатаУстановки = Выборка.ДатаУстановки;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

// Универсальный CSV в UTF-8 для Excel; столбцы разделены точкой с запятой.
// Сделан через двоичные данные, чтобы выгрузка работала без MS Office.
&НаКлиенте
Процедура ВыгрузитьCSV(Команда)
    Если Результат.Количество() = 0 Тогда
        Предупреждение("Сначала сформируйте результат.");
        Возврат;
    КонецЕсли;
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Фильтр = "CSV (*.csv)|*.csv";
    Диалог.ПолноеИмяФайла = "РозничныеЦены_" + Формат(ДатаЦен, "ДФ=yyyyMMdd") + ".csv";
    Если НЕ Диалог.Выбрать() Тогда Возврат; КонецЕсли;
    Запись = Новый ЗаписьТекста(Диалог.ПолноеИмяФайла, КодировкаТекста.UTF8);
    Попытка
        Запись.ЗаписатьСтроку("Магазин;Склад;Код;Номенклатура;Характеристика;Единица;Тип цен;Цена;Валюта;Дата установки");
        Для Каждого Стр Из Результат Цикл
            Линия = CSVПоле(Стр.Магазин) + ";" + CSVПоле(Стр.Склад) + ";" + CSVПоле(Стр.Код) + ";"
                + CSVПоле(Стр.Номенклатура) + ";" + CSVПоле(Стр.Характеристика) + ";"
                + CSVПоле(Стр.Единица) + ";" + CSVПоле(Стр.ТипЦен) + ";"
                + CSVПоле(Формат(Стр.Цена, "ЧГ=0; ЧДЦ=2")) + ";" + CSVПоле(Стр.Валюта) + ";"
                + CSVПоле(Формат(Стр.ДатаУстановки, "ДФ=dd.MM.yyyy HH:mm:ss"));
            Запись.ЗаписатьСтроку(Линия);
        КонецЦикла;
    Исключение
        Запись.Закрыть();
        ВызватьИсключение;
    КонецПопытки;
    Запись.Закрыть();
    Сообщить("CSV сохранён: " + Диалог.ПолноеИмяФайла);
КонецПроцедуры

&НаКлиенте
Функция CSVПоле(Значение)
    Текст = Строка(Значение);
    Текст = СтрЗаменить(Текст, """", """""");
    Возврат """" + Текст + """";
КонецФункции
