&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    КлючУзлаДляОбмена = "";
    УзлыОбмена.Очистить();
    ВидыДокументов.Очистить();
    РезультатыПоиска.Очистить();
    Корзина.Очистить();
    ОтборПоСкладу = "";
    ЛимитДокументовНаВид = 500;
    ЛимитСправочниковНаВид = 5000;
    ЗаполнитьСписокСкладов();
    НастроитьРастягиваниеЭлементов();

    УзелИзПараметров = Неопределено;
    Если Параметры.Свойство("УзелДляОбмена", УзелИзПараметров)
        И ЗначениеЗаполнено(УзелИзПараметров) Тогда
        КлючУзлаДляОбмена = ЗначениеВСтрокуВнутр(УзелИзПараметров);
        ЗагрузитьВидыДокументовНаСервере();
        Если ВидыДокументов.Количество() > 0 Тогда
            ПоказатьСтатусДоступныхВидов();
        КонецЕсли;
    Иначе
        ЗагрузитьУзлыОбменаНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура НастроитьРастягиваниеЭлементов()
    ИменаЭлементовПоГоризонтали = Новый Массив;
    ИменаЭлементовПоГоризонтали.Добавить("ВерхняяПанель");
    ИменаЭлементовПоГоризонтали.Добавить("СтрокаВерхнихПараметров");
    ИменаЭлементовПоГоризонтали.Добавить("НастройкиЛимитов");
    ИменаЭлементовПоГоризонтали.Добавить("ОсновныеСписки");
    ИменаЭлементовПоГоризонтали.Добавить("ГруппаВидовДокументов");
    ИменаЭлементовПоГоризонтали.Добавить("ПанельВидыКорзина");
    ИменаЭлементовПоГоризонтали.Добавить("ГруппаРезультатов");
    ИменаЭлементовПоГоризонтали.Добавить("ГруппаКорзины");
    ИменаЭлементовПоГоризонтали.Добавить("ТаблицаУзловОбмена");
    ИменаЭлементовПоГоризонтали.Добавить("ТаблицаВидовДокументов");
    ИменаЭлементовПоГоризонтали.Добавить("ТаблицаРезультатовПоиска");
    ИменаЭлементовПоГоризонтали.Добавить("ТаблицаКорзины");
    ИменаЭлементовПоГоризонтали.Добавить("КомандыВыбораВидов");
    ИменаЭлементовПоГоризонтали.Добавить("КомандыВыбораРезультатов");
    ИменаЭлементовПоГоризонтали.Добавить("КомандыВыбораКорзины");
    Для Каждого ИмяЭлемента Из ИменаЭлементовПоГоризонтали Цикл
        ЭлементФормы = Элементы.Найти(ИмяЭлемента);
        Если ЭлементФормы <> Неопределено Тогда
            ЭлементФормы.РастягиватьПоГоризонтали = Истина;
        КонецЕсли;
    КонецЦикла;

    ТаблицаРезультатов = Элементы.Найти("ТаблицаРезультатовПоиска");
    Если ТаблицаРезультатов <> Неопределено Тогда
        ТаблицаРезультатов.ГоризонтальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.ИспользоватьВсегда;
    КонецЕсли;

    ИменаЭлементовПоВертикали = Новый Массив;
    ИменаЭлементовПоВертикали.Добавить("ОсновныеСписки");
    ИменаЭлементовПоВертикали.Добавить("ПанельВидыКорзина");
    ИменаЭлементовПоВертикали.Добавить("ГруппаРезультатов");
    ИменаЭлементовПоВертикали.Добавить("ГруппаКорзины");
    ИменаЭлементовПоВертикали.Добавить("ТаблицаРезультатовПоиска");
    ИменаЭлементовПоВертикали.Добавить("ТаблицаКорзины");
    Для Каждого ИмяЭлемента Из ИменаЭлементовПоВертикали Цикл
        ЭлементФормы = Элементы.Найти(ИмяЭлемента);
        Если ЭлементФормы <> Неопределено Тогда
            ЭлементФормы.РастягиватьПоВертикали = Истина;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСкладов()
    ЭлементСклада = Элементы.Найти("ПолеСклад");
    Если ЭлементСклада = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ЭлементСклада.РежимВыбораИзСписка = Истина;
    ЭлементСклада.СписокВыбора.Очистить();
    ЭлементСклада.СписокВыбора.Добавить("", "Все склады");

    ЗапросСкладов = Новый Запрос(
        "ВЫБРАТЬ Склад.Ссылка КАК Ссылка, Склад.Наименование КАК Наименование " +
        "ИЗ Справочник.Склады КАК Склад " +
        "ГДЕ Склад.ПометкаУдаления = ЛОЖЬ " +
        "УПОРЯДОЧИТЬ ПО Склад.Наименование");
    ВыборкаСкладов = ЗапросСкладов.Выполнить().Выбрать();
    Пока ВыборкаСкладов.Следующий() Цикл
        ЭлементСклада.СписокВыбора.Добавить(
            Строка(ВыборкаСкладов.Ссылка.УникальныйИдентификатор()), ВыборкаСкладов.Наименование);
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокУзлов(Команда)
    ОбновитьСписокУзловНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокУзловНаСервере()
    УзлыОбмена.Очистить();
    ЗагрузитьУзлыОбменаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьУзлыОбменаНаСервере()
    МенеджерПлана = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат;
    ТекущийУзел = МенеджерПлана.ЭтотУзел();
    ВыборкаУзлов = МенеджерПлана.Выбрать();
    КоличествоУзловПлана = 0;
    КоличествоУзловПолучателей = 0;
    Пока ВыборкаУзлов.Следующий() Цикл
        КоличествоУзловПлана = КоличествоУзловПлана + 1;
        СтрокаУзла = УзлыОбмена.Добавить();
        СтрокаУзла.Выбрать = Ложь;
        СтрокаУзла.Идентификатор = ЗначениеВСтрокуВнутр(ВыборкаУзлов.Ссылка);
        Если ВыборкаУзлов.Ссылка = ТекущийУзел Тогда
            СтрокаУзла.Представление = "ТЕКУЩИЙ УЗЕЛ: " + Строка(ВыборкаУзлов.Ссылка);
            Продолжить;
        КонецЕсли;
        КоличествоУзловПолучателей = КоличествоУзловПолучателей + 1;
        СтрокаУзла.Представление = Строка(ВыборкаУзлов.Ссылка);
    КонецЦикла;

    Если КоличествоУзловПлана = 0 Тогда
        Статус = "В плане СинхронизацияДанныхЧерезУниверсальныйФормат узлы не найдены. Проверьте настройку синхронизации.";
    ИначеЕсли КоличествоУзловПолучателей = 0 Тогда
        Статус = "Найден только текущий узел базы. Узел второй базы-получателя в плане универсального формата не найден.";
    Иначе
        Статус = СтрШаблон("Найдено узлов-получателей: %1. Текущий узел также показан, но не может быть получателем.", КоличествоУзловПолучателей);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция УзелДопустимДляТиповойСинхронизации(Узел)
    Если ТипЗнч(Узел) <> Тип("ПланОбменаСсылка.СинхронизацияДанныхЧерезУниверсальныйФормат") Тогда
        Возврат Ложь;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Узел) Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат Истина;
КонецФункции

&НаСервере
Процедура ПоказатьСтатусДоступныхВидов()
    Если ВидыДокументов.Количество() = 0 Тогда
        Статус = "В составе выбранного узла не найдены доступные документы и справочники.";
    Иначе
        Статус = СтрШаблон("Доступно типов объектов: %1. Изначально ничего не отмечено; отметьте нужные документы и справочники.",
            ВидыДокументов.Количество());
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВидыДокументов(Команда)
    КлючУзлаДляОбмена = "";
    Для Каждого СтрокаУзла Из УзлыОбмена Цикл
        Если Не СтрокаУзла.Выбрать Тогда
            Продолжить;
        КонецЕсли;
        Если КлючУзлаДляОбмена <> "" Тогда
            Статус = "Отметьте только один узел Бухгалтерии.";
            Возврат;
        КонецЕсли;
        КлючУзлаДляОбмена = СтрокаУзла.Идентификатор;
    КонецЦикла;

    Если ПустаяСтрока(КлючУзлаДляОбмена) Тогда
        Статус = "Сначала отметьте один узел Бухгалтерии в таблице узлов.";
        Возврат;
    КонецЕсли;

    ЗагрузитьВидыДокументовПослеВыбораУзлаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьВидыДокументовПослеВыбораУзлаНаСервере()
    ВидыДокументов.Очистить();
    ЗагрузитьВидыДокументовНаСервере();
    Если ВидыДокументов.Количество() > 0 Тогда
        ПоказатьСтатусДоступныхВидов();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьВидыДокументовНаСервере()
    УзелДляОбмена = ЗначениеИзСтрокиВнутр(КлючУзлаДляОбмена);
    Если Не ЗначениеЗаполнено(УзелДляОбмена) Тогда
        Статус = "Не удалось определить узел обмена.";
        Возврат;
    КонецЕсли;
    Если Не УзелДопустимДляТиповойСинхронизации(УзелДляОбмена) Тогда
        Статус = "Выберите узел плана СинхронизацияДанныхЧерезУниверсальныйФормат.";
        Возврат;
    КонецЕсли;

    СоставУзла = ОбменДаннымиПовтИсп.СоставПланаОбмена(УзелДляОбмена.Метаданные().Имя, Истина, Ложь);
    ДоступныеТипы = Новый Соответствие;
    Для Каждого СтрокаСостава Из СоставУзла Цикл
        Если Лев(СтрокаСостава.ПолноеИмяМетаданных, 9) = "Документ."
            Или Лев(СтрокаСостава.ПолноеИмяМетаданных, 11) = "Справочник." Тогда
            ДоступныеТипы.Вставить(СтрокаСостава.ПолноеИмяМетаданных, Истина);
        КонецЕсли;
    КонецЦикла;

    // Ограничиваем список документами, которые пользователь включил в задачу.
    // Для банковской выписки в метаданных существуют отдельные приходная и
    // расходная строки; оставляем обе разновидности.
    ЦелевыеДокументы = Новый Соответствие;
    ЦелевыеДокументы.Вставить("ZОтчет", Истина);
    ЦелевыеДокументы.Вставить("АктОПереоценке", Истина);
    ЦелевыеДокументы.Вставить("ВозвратПоставщику", Истина);
    ЦелевыеДокументы.Вставить("Инвентаризация", Истина);
    ЦелевыеДокументы.Вставить("КорректировкаПоступления", Истина);
    ЦелевыеДокументы.Вставить("ОтчетОтдела", Истина);
    ЦелевыеДокументы.Вставить("Перемещение", Истина);
    ЦелевыеДокументы.Вставить("Пересортица", Истина);
    ЦелевыеДокументы.Вставить("ПриходнаяНакладная", Истина);
    ЦелевыеДокументы.Вставить("ПриходныйКассовыйОрдер", Истина);
    ЦелевыеДокументы.Вставить("РасходнаяНакладная", Истина);
    ЦелевыеДокументы.Вставить("РасходныйКассовыйОрдер", Истина);
    ЦелевыеДокументы.Вставить("Списание", Истина);
    ЦелевыеДокументы.Вставить("СтрокиБанковскойВыпискиПриход", Истина);
    ЦелевыеДокументы.Вставить("СтрокиБанковскойВыпискиРасход", Истина);
    ЦелевыеДокументы.Вставить("СчетФактураВыданный", Истина);
    ЦелевыеДокументы.Вставить("СчетФактураПолученный", Истина);
    ЦелевыеДокументы.Вставить("СинхронизацияДокументовСБухгалтериейСлужебный", Истина);

    Для Каждого ДокументМетаданные Из Метаданные.Документы Цикл
        Если ЦелевыеДокументы[ДокументМетаданные.Имя] <> Истина Тогда
            Продолжить;
        КонецЕсли;
        ПолноеИмяМетаданных = "Документ." + ДокументМетаданные.Имя;
        Если ДоступныеТипы[ПолноеИмяМетаданных] <> Истина Тогда
            Продолжить;
        КонецЕсли;

        СтрокаВида = ВидыДокументов.Добавить();
        СтрокаВида.Выбрать = Ложь;
        СтрокаВида.ТипОбъекта = "Документ";
        СтрокаВида.Имя = ДокументМетаданные.Имя;
        СтрокаВида.Представление = Строка(ДокументМетаданные.Синоним);
        СтрокаВида.РеквизитыСклада = СписокРеквизитовСклада(ДокументМетаданные);
    КонецЦикла;

    ЦелевыеСправочники = Новый Соответствие;
    ЦелевыеСправочники.Вставить("БанковскиеСчета", Истина);
    ЦелевыеСправочники.Вставить("Валюты", Истина);
    ЦелевыеСправочники.Вставить("ВидыОплат", Истина);
    ЦелевыеСправочники.Вставить("ДоговорыВзаиморасчетов", Истина);
    ЦелевыеСправочники.Вставить("КлассификаторЕдиницИзмерения", Истина);
    ЦелевыеСправочники.Вставить("Контрагенты", Истина);
    ЦелевыеСправочники.Вставить("Номенклатура", Истина);
    ЦелевыеСправочники.Вставить("Подразделения", Истина);
    ЦелевыеСправочники.Вставить("Склады", Истина);
    ЦелевыеСправочники.Вставить("КлассификаторБанков", Истина);
    ЦелевыеСправочники.Вставить("ДвиженияДенежныхСредств", Истина);
    ЦелевыеСправочники.Вставить("ФизическиеЛица", Истина);
    ЦелевыеСправочники.Вставить("Организации", Истина);
    ЦелевыеСправочники.Вставить("ШтрихКоды", Истина);

    Для Каждого СправочникМетаданные Из Метаданные.Справочники Цикл
        ПолноеИмяМетаданных = "Справочник." + СправочникМетаданные.Имя;
        // Показываем разрешенные справочники независимо от текущего состава узла.
        // При регистрации состав узла все равно проверяется отдельно.
        Если ЦелевыеСправочники[СправочникМетаданные.Имя] <> Истина Тогда
            Продолжить;
        КонецЕсли;

        СтрокаВида = ВидыДокументов.Добавить();
        СтрокаВида.Выбрать = Ложь;
        СтрокаВида.ТипОбъекта = "Справочник";
        СтрокаВида.Имя = СправочникМетаданные.Имя;
        СтрокаВида.Представление = Строка(СправочникМетаданные.Синоним);
        СтрокаВида.РеквизитыСклада = "";
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СписокРеквизитовСклада(ДокументМетаданные)
    Результат = "";
    Если ДокументМетаданные.Имя = "ZОтчет" Тогда
        Возврат "ККМ.ТорговыйОбъект";
    КонецЕсли;
    Для Каждого РеквизитМетаданные Из ДокументМетаданные.Реквизиты Цикл
        Если ЭтоРеквизитСклада(РеквизитМетаданные) Тогда
            Если Результат <> "" Тогда
                Результат = Результат + ", ";
            КонецЕсли;
            Результат = Результат + РеквизитМетаданные.Имя;
        ИначеЕсли ЭтоРеквизитККМ(РеквизитМетаданные) Тогда
            Если Результат <> "" Тогда
                Результат = Результат + ", ";
            КонецЕсли;
            Результат = Результат + РеквизитМетаданные.Имя + ".Склад";
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервере
Функция УсловияОтбораПоСкладу(ДокументМетаданные)
    Результат = Новый Массив;
    ЭтоZОтчет = ДокументМетаданные.Имя = "ZОтчет";
    Если ЭтоZОтчет Тогда
        Результат.Добавить("Документ.ККМ.ТорговыйОбъект = &ТорговыйОбъектДляОтбора");
    КонецЕсли;
    Для Каждого РеквизитМетаданные Из ДокументМетаданные.Реквизиты Цикл
        Если ЭтоРеквизитСклада(РеквизитМетаданные) Тогда
            Результат.Добавить("Документ." + РеквизитМетаданные.Имя + " = &СкладДляОтбора");
        ИначеЕсли Не ЭтоZОтчет И ЭтоРеквизитККМ(РеквизитМетаданные) Тогда
            Результат.Добавить("Документ." + РеквизитМетаданные.Имя + ".Склад = &СкладДляОтбора");
        КонецЕсли;
    КонецЦикла;

    НомерТабличнойЧасти = 0;
    Для Каждого ТабличнаяЧастьМетаданные Из ДокументМетаданные.ТабличныеЧасти Цикл
        Для Каждого РеквизитМетаданные Из ТабличнаяЧастьМетаданные.Реквизиты Цикл
            Если ЭтоРеквизитСклада(РеквизитМетаданные) Тогда
                НомерТабличнойЧасти = НомерТабличнойЧасти + 1;
                Псевдоним = "СтрокиТЧ" + Строка(НомерТабличнойЧасти);
                Подзапрос = "Документ.Ссылка В (ВЫБРАТЬ " + Псевдоним + ".Ссылка ИЗ Документ." +
                    ДокументМетаданные.Имя + "." + ТабличнаяЧастьМетаданные.Имя + " КАК " + Псевдоним +
                    " ГДЕ " + Псевдоним + "." + РеквизитМетаданные.Имя + " = &СкладДляОтбора)";
                Результат.Добавить(Подзапрос);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервере
Функция ЭтоРеквизитСклада(РеквизитМетаданные)
    ТипСсылкиНаСклад = ТипЗнч(Справочники.Склады.ПустаяСсылка());
    Возврат РеквизитМетаданные.Тип.СодержитТип(ТипСсылкиНаСклад);
КонецФункции

&НаСервере
Функция ЭтоРеквизитККМ(РеквизитМетаданные)
    ТипСсылкиНаККМ = ТипЗнч(Справочники.ККМ.ПустаяСсылка());
    Возврат РеквизитМетаданные.Тип.СодержитТип(ТипСсылкиНаККМ);
КонецФункции

&НаСервере
Функция ПолучитьСвязанныеДокументыОтчетаОтдела(СсылкаОтчета, ДиагностикаСвязей = Неопределено)
    Результат = Новый Массив;
    УжеДобавлены = Новый Соответствие;
    ТипСсылкиНаZОтчет = Тип("ДокументСсылка.ZОтчет");
    ТипСсылкиНаККМ = Тип("СправочникСсылка.ККМ");
    ТипДаты = Тип("Дата");
    ОбъектОтчета = СсылкаОтчета.ПолучитьОбъект();
    МетаданныеОтчета = СсылкаОтчета.Метаданные();

    Если ДиагностикаСвязей <> Неопределено И ДиагностикаСвязей.Количество() = 0 Тогда
        ДиагностикаСвязей.Добавить("ОтчетОтдела " + Строка(СсылкаОтчета) + "; реквизиты ККМ/дата:");
    КонецЕсли;

    // Если в метаданных отчета есть прямая ссылка на Z-отчет,
    // добавляем ее независимо от конкретного имени реквизита.
    Для Каждого РеквизитОтчета Из МетаданныеОтчета.Реквизиты Цикл
        Если ДиагностикаСвязей <> Неопределено Тогда
            Если РеквизитОтчета.Тип.СодержитТип(ТипСсылкиНаККМ)
                Или РеквизитОтчета.Тип.СодержитТип(ТипДаты)
                Или РеквизитОтчета.Тип.СодержитТип(ТипСсылкиНаZОтчет) Тогда
                ДиагностикаСвязей.Добавить(РеквизитОтчета.Имя + "=" + Строка(ОбъектОтчета[РеквизитОтчета.Имя]));
            КонецЕсли;
        КонецЕсли;
        Если РеквизитОтчета.Тип.СодержитТип(ТипСсылкиНаZОтчет) Тогда
            СсылкаСвязанногоДокумента = ОбъектОтчета[РеквизитОтчета.Имя];
            Если ЗначениеЗаполнено(СсылкаСвязанногоДокумента)
                И УжеДобавлены[ЗначениеВСтрокуВнутр(СсылкаСвязанногоДокумента)] = Неопределено Тогда
                Результат.Добавить(СсылкаСвязанногоДокумента);
                УжеДобавлены.Вставить(ЗначениеВСтрокуВнутр(СсылкаСвязанногоДокумента), Истина);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Для Каждого ТабличнаяЧастьОтчета Из МетаданныеОтчета.ТабличныеЧасти Цикл
        СтрокиТабличнойЧасти = ОбъектОтчета[ТабличнаяЧастьОтчета.Имя];
        Для Каждого РеквизитСтроки Из ТабличнаяЧастьОтчета.Реквизиты Цикл
            Если ДиагностикаСвязей <> Неопределено Тогда
                Если РеквизитСтроки.Тип.СодержитТип(ТипСсылкиНаККМ)
                    Или РеквизитСтроки.Тип.СодержитТип(ТипДаты)
                    Или РеквизитСтроки.Тип.СодержитТип(ТипСсылкиНаZОтчет) Тогда
                    НомерСтрокиДиагностики = 0;
                    Для Каждого СтрокаДиагностики Из СтрокиТабличнойЧасти Цикл
                        НомерСтрокиДиагностики = НомерСтрокиДиагностики + 1;
                        Если НомерСтрокиДиагностики > 3 Тогда
                            Прервать;
                        КонецЕсли;
                        ДиагностикаСвязей.Добавить(ТабличнаяЧастьОтчета.Имя + "." + РеквизитСтроки.Имя + "=" +
                            Строка(СтрокаДиагностики[РеквизитСтроки.Имя]));
                    КонецЦикла;
                КонецЕсли;
            КонецЕсли;
            Если Не РеквизитСтроки.Тип.СодержитТип(ТипСсылкиНаZОтчет) Тогда
                Продолжить;
            КонецЕсли;
            Для Каждого СтрокаТабличнойЧасти Из СтрокиТабличнойЧасти Цикл
                СсылкаСвязанногоДокумента = СтрокаТабличнойЧасти[РеквизитСтроки.Имя];
                Если ЗначениеЗаполнено(СсылкаСвязанногоДокумента)
                    И УжеДобавлены[ЗначениеВСтрокуВнутр(СсылкаСвязанногоДокумента)] = Неопределено Тогда
                    Результат.Добавить(СсылкаСвязанногоДокумента);
                    УжеДобавлены.Вставить(ЗначениеВСтрокуВнутр(СсылкаСвязанногоДокумента), Истина);
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;

    // В ТП7 связь с Z-отчетом может храниться со стороны Z-отчета:
    // Z-отчет подчинен ОтчетуОтдела и содержит ссылку на него.
    ТипСсылкиНаОтчетОтдела = Тип("ДокументСсылка.ОтчетОтдела");
    УсловияСвязиZОтчета = Новый Массив;
    МетаданныеZОтчета = Метаданные.Документы.ZОтчет;
    Для Каждого РеквизитZОтчета Из МетаданныеZОтчета.Реквизиты Цикл
        Если РеквизитZОтчета.Тип.СодержитТип(ТипСсылкиНаОтчетОтдела) Тогда
            УсловияСвязиZОтчета.Добавить("ДокументZ." + РеквизитZОтчета.Имя + " = &СсылкаОтчета");
            Если ДиагностикаСвязей <> Неопределено Тогда
                ДиагностикаСвязей.Добавить("ZОтчет." + РеквизитZОтчета.Имя + " -> ОтчетОтдела");
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Для Каждого ТабличнаяЧастьZОтчета Из МетаданныеZОтчета.ТабличныеЧасти Цикл
        Для Каждого РеквизитСтрокиZОтчета Из ТабличнаяЧастьZОтчета.Реквизиты Цикл
            Если РеквизитСтрокиZОтчета.Тип.СодержитТип(ТипСсылкиНаОтчетОтдела) Тогда
                УсловияСвязиZОтчета.Добавить(
                    "ДокументZ.Ссылка В (ВЫБРАТЬ СтрокиZ.Ссылка ИЗ Документ.ZОтчет." +
                    ТабличнаяЧастьZОтчета.Имя + " КАК СтрокиZ ГДЕ СтрокиZ." +
                    РеквизитСтрокиZОтчета.Имя + " = &СсылкаОтчета)");
                Если ДиагностикаСвязей <> Неопределено Тогда
                    ДиагностикаСвязей.Добавить("ZОтчет." + ТабличнаяЧастьZОтчета.Имя + "." +
                        РеквизитСтрокиZОтчета.Имя + " -> ОтчетОтдела");
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Если УсловияСвязиZОтчета.Количество() > 0 Тогда
        ТекстЗапросаZОтчетов =
            "ВЫБРАТЬ ПЕРВЫЕ 100" + Символы.ПС +
            "    ДокументZ.Ссылка КАК Ссылка" + Символы.ПС +
            "ИЗ" + Символы.ПС +
            "    Документ.ZОтчет КАК ДокументZ" + Символы.ПС +
            "ГДЕ " + СтрСоединить(УсловияСвязиZОтчета, " ИЛИ ");
        ЗапросZОтчетов = Новый Запрос(ТекстЗапросаZОтчетов);
        ЗапросZОтчетов.УстановитьПараметр("СсылкаОтчета", СсылкаОтчета);
        ВыборкаZОтчетов = ЗапросZОтчетов.Выполнить().Выбрать();
        Пока ВыборкаZОтчетов.Следующий() Цикл
            СсылкаZОтчета = ВыборкаZОтчетов.Ссылка;
            КлючZОтчета = ЗначениеВСтрокуВнутр(СсылкаZОтчета);
            Если УжеДобавлены[КлючZОтчета] = Неопределено Тогда
                Результат.Добавить(СсылкаZОтчета);
                УжеДобавлены.Вставить(КлючZОтчета, Истина);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    // Типовой механизм ТП7 формирует связанные документы бухгалтерии для ОтчетаОтдела.
    // Флаг отключает регистрацию во время получения состава связей.
    ДополнительныеСвойства = Новый Структура("ОтключитьМеханизмРегистрацииОбъектов", Истина);
    МассивДокументовБухгалтерии = Обработки.ПомощникИнтерактивногоОбменаДанными.ТП_РегистрацияМногофирменногоУчетаДляСинхронизации(ОбъектОтчета, ДополнительныеСвойства);
    Для Каждого СсылкаСвязанногоДокумента Из МассивДокументовБухгалтерии Цикл
        Если Не ЗначениеЗаполнено(СсылкаСвязанногоДокумента) Тогда
            Продолжить;
        КонецЕсли;
        Если Лев(СсылкаСвязанногоДокумента.Метаданные().ПолноеИмя(), 9) <> "Документ." Тогда
            Продолжить;
        КонецЕсли;
        КлючСвязи = ЗначениеВСтрокуВнутр(СсылкаСвязанногоДокумента);
        Если УжеДобавлены[КлючСвязи] = Неопределено Тогда
            Результат.Добавить(СсылкаСвязанногоДокумента);
            УжеДобавлены.Вставить(КлючСвязи, Истина);
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;
КонецФункции

&НаСервере
Функция ДобавитьСвязанныеДокументыОтчетаВРезультаты(СсылкаОтчета, ДиагностикаСвязейОтчетов)
    КоличествоДобавлено = 0;
    КоличествоZОтчетов = 0;
    ИдентификаторРодителя = ЗначениеВСтрокуВнутр(СсылкаОтчета);
    УзелДляОбмена = ЗначениеИзСтрокиВнутр(КлючУзлаДляОбмена);
    ДиагностикаСвязейОтчета = Новый Массив;
    МассивСвязанныхДокументов = ПолучитьСвязанныеДокументыОтчетаОтдела(СсылкаОтчета, ДиагностикаСвязейОтчета);
    Если ДиагностикаСвязейОтчетов.Количество() = 0 Тогда
        Для Каждого ЭлементДиагностики Из ДиагностикаСвязейОтчета Цикл
            ДиагностикаСвязейОтчетов.Добавить(ЭлементДиагностики);
        КонецЦикла;
    КонецЕсли;

    Для Каждого СсылкаСвязанногоДокумента Из МассивСвязанныхДокументов Цикл
        Если СсылкаСвязанногоДокумента = СсылкаОтчета Тогда
            Продолжить;
        КонецЕсли;
        МетаданныеСвязанногоДокумента = СсылкаСвязанногоДокумента.Метаданные();
        Если МетаданныеСвязанногоДокумента.Имя = "ZОтчет" Тогда
            КоличествоZОтчетов = КоличествоZОтчетов + 1;
        КонецЕсли;
        ВходитВСоставУзла = УзелДляОбмена.Метаданные().Состав.Найти(МетаданныеСвязанногоДокумента) <> Неопределено;
        СтрокаСвязанногоДокумента = РезультатыПоиска.Добавить();
        СтрокаСвязанногоДокумента.Выбрать = ВходитВСоставУзла;
        СтрокаСвязанногоДокумента.ЭтоСвязанный = Истина;
        СтрокаСвязанногоДокумента.РодительИдентификатор = ИдентификаторРодителя;
        СтрокаСвязанногоДокумента.ДоступенДляОбмена = ВходитВСоставУзла;
        СтрокаСвязанногоДокумента.Идентификатор = ЗначениеВСтрокуВнутр(СсылкаСвязанногоДокумента);
        СтрокаСвязанногоДокумента.ВидДокумента = Строка(МетаданныеСвязанногоДокумента.Синоним);
        СтрокаСвязанногоДокумента.Дата = СсылкаСвязанногоДокумента.Дата;
        СтрокаСвязанногоДокумента.Номер = Строка(СсылкаСвязанногоДокумента.Номер);
        ПредставлениеСвязи = "    -> " + СтрокаСвязанногоДокумента.ВидДокумента +
            " №" + СтрокаСвязанногоДокумента.Номер + " от " +
            Формат(СтрокаСвязанногоДокумента.Дата, "ДФ=yyyy-MM-dd HH:mm:ss");
        Если Не ВходитВСоставУзла Тогда
            ПредставлениеСвязи = ПредставлениеСвязи + " (не входит в состав узла)";
        КонецЕсли;
        СтрокаСвязанногоДокумента.Представление = ПредставлениеСвязи;
        КоличествоДобавлено = КоличествоДобавлено + 1;
    КонецЦикла;

    Возврат Новый Структура("Добавлено,ZОтчетов", КоличествоДобавлено, КоличествоZОтчетов);
КонецФункции

&НаКлиенте
Процедура НайтиДокументы(Команда)
    Если ПустаяСтрока(КлючУзлаДляОбмена) Тогда
        Статус = "Нет узла обмена. Откройте обработку из формы синхронизации.";
        Возврат;
    КонецЕсли;
    ЕстьВыбранныеТипы = Ложь;
    Для Каждого СтрокаВида Из ВидыДокументов Цикл
        Если Не СтрокаВида.Выбрать Тогда
            Продолжить;
        КонецЕсли;
        ЕстьВыбранныеТипы = Истина;
    КонецЦикла;
    Если Не ЕстьВыбранныеТипы Тогда
        Статус = "Отметьте хотя бы один документ или справочник.";
        Возврат;
    КонецЕсли;
    ВыбранныйСклад = ОтборПоСкладу;
    НайтиДокументыНаСервере(ДатаНачала, ДатаОкончания, ВыбранныйСклад);
    ОтборПоСкладу = ВыбранныйСклад;
КонецПроцедуры

&НаСервере
Процедура НайтиДокументыНаСервере(НачалоПериода, ОкончаниеПериода, СкладДляОтбора)
    Если ЛимитДокументовНаВид < 0 Тогда
        ЛимитДокументовНаВид = 0;
    КонецЕсли;
    Если ЛимитСправочниковНаВид < 0 Тогда
        ЛимитСправочниковНаВид = 0;
    КонецЕсли;
    ЕстьПериодДляДокументов = НачалоПериода <> Неопределено
        И ОкончаниеПериода <> Неопределено
        И НачалоПериода <= ОкончаниеПериода;
    Если СкладДляОтбора = Неопределено Тогда
        СкладДляОтбора = "";
    КонецЕсли;
    ЕстьОтборПоСкладу = Ложь;
    Если ПустаяСтрока(СокрЛП(СкладДляОтбора)) Тогда
        СкладДляОтбора = Неопределено;
    Иначе
        Попытка
            ИдентификаторСклада = Новый УникальныйИдентификатор(СокрЛП(СкладДляОтбора));
            СкладДляОтбора = Справочники.Склады.ПолучитьСсылку(ИдентификаторСклада);
            ЕстьОтборПоСкладу = Истина;
        Исключение
            Статус = "Не удалось прочитать выбранный склад. Выберите его из списка еще раз.";
            Возврат;
        КонецПопытки;
    КонецЕсли;

    ТорговыйОбъектДляОтбора = Неопределено;
    Если ЕстьОтборПоСкладу Тогда
        ЗапросТорговогоОбъекта = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1 Склад.ТорговыйОбъект КАК ТорговыйОбъект " +
            "ИЗ Справочник.Склады КАК Склад " +
            "ГДЕ Склад.Ссылка = &СкладДляОтбора");
        ЗапросТорговогоОбъекта.УстановитьПараметр("СкладДляОтбора", СкладДляОтбора);
        ВыборкаТорговогоОбъекта = ЗапросТорговогоОбъекта.Выполнить().Выбрать();
        Если ВыборкаТорговогоОбъекта.Следующий() Тогда
            ТорговыйОбъектДляОтбора = ВыборкаТорговогоОбъекта.ТорговыйОбъект;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ТорговыйОбъектДляОтбора) Тогда
            ТорговыйОбъектДляОтбора = Справочники.ТорговыеОбъекты.ПустаяСсылка();
        КонецЕсли;
    КонецЕсли;

    РезультатыПоиска.Очистить();
    КоличествоВыбраноВидов = 0;
    КоличествоВыбраноДокументов = 0;
    КоличествоДокументовБезПериода = 0;
    КоличествоНайдено = 0;
    КоличествоСвязанныхДокументов = 0;
    КоличествоПроверенныхОтчетовОтдела = 0;
    КоличествоZОтчетов = 0;
    ДиагностикаСвязейОтчетов = Новый Массив;
    КоличествоПропущеноПоСкладу = 0;
    СписокПропущенныхТиповСклада = "";
    КоличествоОшибок = 0;
    ДостигнутЛимитДокументов = Ложь;
    ДостигнутЛимитСправочников = Ложь;
    ПодробностиОшибок = "";

    Для Каждого СтрокаВида Из ВидыДокументов Цикл
        Если Не СтрокаВида.Выбрать Тогда
            Продолжить;
        КонецЕсли;

        КоличествоВыбраноВидов = КоличествоВыбраноВидов + 1;
        Если СтрокаВида.ТипОбъекта = "Справочник" Тогда
            Попытка
                ПрефиксВыбораСправочника = "ВЫБРАТЬ";
                Если ЛимитСправочниковНаВид > 0 Тогда
                    ПрефиксВыбораСправочника = "ВЫБРАТЬ ПЕРВЫЕ " + Строка(Цел(ЛимитСправочниковНаВид));
                КонецЕсли;
                ТекстЗапросаСправочника = ПрефиксВыбораСправочника + Символы.ПС +
                    "    Элемент.Ссылка КАК Ссылка," + Символы.ПС +
                    "    Элемент.Наименование КАК Наименование" + Символы.ПС +
                    "ИЗ Справочник." + СтрокаВида.Имя + " КАК Элемент" + Символы.ПС +
                    "УПОРЯДОЧИТЬ ПО Элемент.Наименование";
                ЗапросСправочника = Новый Запрос(ТекстЗапросаСправочника);
                ВыборкаСправочника = ЗапросСправочника.Выполнить().Выбрать();
                КоличествоНайденоПоВиду = 0;
                Пока ВыборкаСправочника.Следующий() Цикл
                    СтрокаРезультата = РезультатыПоиска.Добавить();
                    СтрокаРезультата.Выбрать = Ложь;
                    СтрокаРезультата.ЭтоСвязанный = Ложь;
                    СтрокаРезультата.РодительИдентификатор = "";
                    СтрокаРезультата.ДоступенДляОбмена = Истина;
                    СтрокаРезультата.Идентификатор = ЗначениеВСтрокуВнутр(ВыборкаСправочника.Ссылка);
                    СтрокаРезультата.ВидДокумента = СтрокаВида.Представление;
                    СтрокаРезультата.Номер = "";
                    СтрокаРезультата.Представление = ВыборкаСправочника.Наименование;
                    КоличествоНайдено = КоличествоНайдено + 1;
                    КоличествоНайденоПоВиду = КоличествоНайденоПоВиду + 1;
                    Если ЛимитСправочниковНаВид > 0
                        И КоличествоНайденоПоВиду >= ЛимитСправочниковНаВид Тогда
                        ДостигнутЛимитСправочников = Истина;
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
            Исключение
                КоличествоОшибок = КоличествоОшибок + 1;
                Если ПодробностиОшибок = "" Тогда
                    ПодробностиОшибок = "Первая ошибка (" + СтрокаВида.Имя + "): " + ОписаниеОшибки();
                КонецЕсли;
            КонецПопытки;
            Продолжить;
        КонецЕсли;
        КоличествоВыбраноДокументов = КоличествоВыбраноДокументов + 1;
        Если Не ЕстьПериодДляДокументов Тогда
            КоличествоДокументовБезПериода = КоличествоДокументовБезПериода + 1;
            Продолжить;
        КонецЕсли;

        МетаданныеДокумента = Метаданные.Документы.Найти(СтрокаВида.Имя);
        Если МетаданныеДокумента = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        УсловияСклада = УсловияОтбораПоСкладу(МетаданныеДокумента);
        Если ЕстьОтборПоСкладу Тогда
            Если УсловияСклада.Количество() = 0 Тогда
                КоличествоПропущеноПоСкладу = КоличествоПропущеноПоСкладу + 1;
                Если СписокПропущенныхТиповСклада <> "" Тогда
                    СписокПропущенныхТиповСклада = СписокПропущенныхТиповСклада + ", ";
                КонецЕсли;
                СписокПропущенныхТиповСклада = СписокПропущенныхТиповСклада + СтрокаВида.Имя;
                Продолжить;
            КонецЕсли;
        КонецЕсли;

        ПрефиксВыбораДокумента = "ВЫБРАТЬ";
        Если ЛимитДокументовНаВид > 0 Тогда
            ПрефиксВыбораДокумента = "ВЫБРАТЬ ПЕРВЫЕ " + Строка(Цел(ЛимитДокументовНаВид));
        КонецЕсли;
        ТекстЗапроса = ПрефиксВыбораДокумента + Символы.ПС +
            "    Документ.Ссылка КАК Ссылка," + Символы.ПС +
            "    Документ.Дата КАК Дата," + Символы.ПС +
            "    Документ.Номер КАК Номер";
        РеквизитыСклада = Новый Массив;
        Если СтрокаВида.Имя = "ZОтчет" Тогда
            РеквизитыСклада.Добавить("ККМ.ТорговыйОбъект");
        КонецЕсли;
        Для Каждого РеквизитМетаданные Из МетаданныеДокумента.Реквизиты Цикл
            Если ЭтоРеквизитСклада(РеквизитМетаданные) Тогда
                РеквизитыСклада.Добавить(РеквизитМетаданные.Имя);
            ИначеЕсли СтрокаВида.Имя <> "ZОтчет" И ЭтоРеквизитККМ(РеквизитМетаданные) Тогда
                РеквизитыСклада.Добавить(РеквизитМетаданные.Имя + ".Склад");
            КонецЕсли;
        КонецЦикла;
        Если РеквизитыСклада.Количество() > 0 Тогда
            ВыражениеСклада = "Документ." + РеквизитыСклада[0];
            Если ЕстьОтборПоСкладу И РеквизитыСклада.Количество() > 1 Тогда
                ВыражениеСклада = "ВЫБОР ";
                Для Каждого ИмяРеквизитаСклада Из РеквизитыСклада Цикл
                    ВыражениеРеквизитаСклада = "Документ." + ИмяРеквизитаСклада;
                    ВыражениеСклада = ВыражениеСклада + "КОГДА " + ВыражениеРеквизитаСклада +
                        " = &СкладДляОтбора ТОГДА " + ВыражениеРеквизитаСклада + " ";
                КонецЦикла;
                ВыражениеСклада = ВыражениеСклада + "ИНАЧЕ Документ." + РеквизитыСклада[0] + " КОНЕЦ";
            КонецЕсли;
            ТекстЗапроса = ТекстЗапроса + "," + Символы.ПС +
                "    " + ВыражениеСклада + " КАК Склад";
        ИначеЕсли ЕстьОтборПоСкладу Тогда
            ТекстЗапроса = ТекстЗапроса + "," + Символы.ПС +
                "    &СкладДляОтбора КАК Склад";
        Иначе
            ТекстЗапроса = ТекстЗапроса + "," + Символы.ПС +
                "    'Без склада' КАК Склад";
        КонецЕсли;
        ТекстЗапроса = ТекстЗапроса + Символы.ПС +
            "ИЗ Документ." + СтрокаВида.Имя + " КАК Документ" + Символы.ПС +
            "ГДЕ Документ.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода";

        Если ЕстьОтборПоСкладу И УсловияСклада.Количество() > 0 Тогда
            ТекстЗапроса = ТекстЗапроса + Символы.ПС + "    И (" + СтрСоединить(УсловияСклада, " ИЛИ ") + ")";
        КонецЕсли;
        ТекстЗапроса = ТекстЗапроса + Символы.ПС + "УПОРЯДОЧИТЬ ПО Документ.Дата УБЫВ";

        Попытка
            Запрос = Новый Запрос(ТекстЗапроса);
            Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
            Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ОкончаниеПериода));
            Если ЕстьОтборПоСкладу И УсловияСклада.Количество() > 0 Тогда
                Если СтрокаВида.Имя = "ZОтчет" Тогда
                    Запрос.УстановитьПараметр("ТорговыйОбъектДляОтбора", ТорговыйОбъектДляОтбора);
                Иначе
                    Запрос.УстановитьПараметр("СкладДляОтбора", СкладДляОтбора);
                КонецЕсли;
            КонецЕсли;

            Выборка = Запрос.Выполнить().Выбрать();
            КоличествоНайденоПоВиду = 0;
            Пока Выборка.Следующий() Цикл
                СтрокаРезультата = РезультатыПоиска.Добавить();
                СтрокаРезультата.Выбрать = Ложь;
            СтрокаРезультата.ЭтоСвязанный = Ложь;
            СтрокаРезультата.РодительИдентификатор = "";
            СтрокаРезультата.ДоступенДляОбмена = Истина;
                СтрокаРезультата.Идентификатор = ЗначениеВСтрокуВнутр(Выборка.Ссылка);
                СтрокаРезультата.ВидДокумента = СтрокаВида.Представление;
                СтрокаРезультата.Дата = Выборка.Дата;
                СтрокаРезультата.Номер = Строка(Выборка.Номер);
                СтрокаРезультата.Представление = Строка(Выборка.Склад) + "*" +
                    СтрокаВида.Представление + "_" + Формат(Выборка.Дата, "ДФ=yyyy-MM-dd HH:mm:ss");
                КоличествоНайдено = КоличествоНайдено + 1;
                КоличествоНайденоПоВиду = КоличествоНайденоПоВиду + 1;
            Если СтрокаВида.Имя = "ОтчетОтдела" Тогда
                КоличествоПроверенныхОтчетовОтдела = КоличествоПроверенныхОтчетовОтдела + 1;
                Попытка
                    РезультатДобавленияСвязей = ДобавитьСвязанныеДокументыОтчетаВРезультаты(
                        Выборка.Ссылка, ДиагностикаСвязейОтчетов);
                    КоличествоДобавленоСвязанных = РезультатДобавленияСвязей.Добавлено;
                    КоличествоZОтчетов = КоличествоZОтчетов + РезультатДобавленияСвязей.ZОтчетов;
                    КоличествоСвязанныхДокументов = КоличествоСвязанныхДокументов + КоличествоДобавленоСвязанных;
                    КоличествоНайдено = КоличествоНайдено + КоличествоДобавленоСвязанных;
                Исключение
                    КоличествоОшибок = КоличествоОшибок + 1;
                    Если ПодробностиОшибок = "" Тогда
                        ПодробностиОшибок = "Не удалось определить связи Отчета отдела: " + ОписаниеОшибки();
                    КонецЕсли;
                КонецПопытки;
            КонецЕсли;
                Если ЛимитДокументовНаВид > 0
                    И КоличествоНайденоПоВиду >= ЛимитДокументовНаВид Тогда
                    ДостигнутЛимитДокументов = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            Если ПодробностиОшибок = "" Тогда
                ПодробностиОшибок = "Первая ошибка (" + СтрокаВида.Имя + "): " + ОписаниеОшибки();
            КонецЕсли;
        КонецПопытки;
    КонецЦикла;

    Если КоличествоВыбраноВидов = 0 Тогда
        Статус = "Сначала отметьте хотя бы один документ или справочник.";
    Иначе
        Статус = СтрШаблон("Найдено: %1. Типов без реквизита склада пропущено: %2. Ошибок: %3. В корзине: %4.",
            КоличествоНайдено, КоличествоПропущеноПоСкладу, КоличествоОшибок, Корзина.Количество());
        Если ДостигнутЛимитДокументов Тогда
            Статус = Статус + СтрШаблон(" Достигнут лимит документов на вид: %1.", ЛимитДокументовНаВид);
        КонецЕсли;
        Если ДостигнутЛимитСправочников Тогда
            Статус = Статус + СтрШаблон(" Достигнут лимит справочников на вид: %1.", ЛимитСправочниковНаВид);
        КонецЕсли;
        Если КоличествоДокументовБезПериода > 0 Тогда
            Статус = Статус + " Документы пропущены: укажите корректные даты начала и окончания периода. Справочники ищутся без фильтра по времени.";
        КонецЕсли;
        Если КоличествоСвязанныхДокументов > 0 Тогда
            Статус = Статус + СтрШаблон(" Связанные документы Отчета отдела: %1; они отмечены автоматически.",
                КоличествоСвязанныхДокументов);
        ИначеЕсли КоличествоПроверенныхОтчетовОтдела > 0 Тогда
            Статус = Статус + СтрШаблон(" Проверено отчетов отдела: %1, связанных документов не возвращено.",
                КоличествоПроверенныхОтчетовОтдела);
        КонецЕсли;
        Если ДиагностикаСвязейОтчетов.Количество() > 0 И КоличествоZОтчетов = 0 Тогда
            Статус = Статус + " Реквизиты отчета для связи: " +
                Лев(СтрСоединить(ДиагностикаСвязейОтчетов, "; "), 450) + ".";
        КонецЕсли;
        Если Не ЕстьОтборПоСкладу Тогда
            Статус = Статус + " Отбор по складу отключен: ищем по всем складам.";
        КонецЕсли;
        Если СписокПропущенныхТиповСклада <> "" Тогда
            Статус = Статус + " Пропущены виды: " + СписокПропущенныхТиповСклада + ".";
        КонецЕсли;
        Если КоличествоНайдено = 0 И КоличествоОшибок = 0 Тогда
            Если КоличествоВыбраноДокументов > 0 Тогда
                Статус = Статус + " Проверьте период и фильтр склада.";
            Иначе
                Статус = Статус + " В отмеченных справочниках элементы не найдены.";
            КонецЕсли;
        ИначеЕсли ПодробностиОшибок <> "" Тогда
            Статус = Статус + " " + Лев(ПодробностиОшибок, 180);
        КонецЕсли;
        Если ЕстьОтборПоСкладу И КоличествоВыбраноДокументов > 0
            И КоличествоНайдено = 0 И КоличествоОшибок = 0 Тогда
            КоличествоБезФильтраСклада = 0;
            ОшибкаПодсчетаБезФильтра = Ложь;
            Для Каждого СтрокаВидаДиагностики Из ВидыДокументов Цикл
                Если Не СтрокаВидаДиагностики.Выбрать Тогда
                    Продолжить;
                КонецЕсли;
                Если СтрокаВидаДиагностики.ТипОбъекта <> "Документ" Тогда
                    Продолжить;
                КонецЕсли;
                ЗапросБезСклада = Новый Запрос(
                    "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество " +
                    "ИЗ Документ." + СтрокаВидаДиагностики.Имя + " КАК Документ " +
                    "ГДЕ Документ.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода");
                ЗапросБезСклада.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
                ЗапросБезСклада.УстановитьПараметр("ОкончаниеПериода", КонецДня(ОкончаниеПериода));
                Попытка
                    ВыборкаБезСклада = ЗапросБезСклада.Выполнить().Выбрать();
                    Если ВыборкаБезСклада.Следующий() Тогда
                        КоличествоБезФильтраСклада = КоличествоБезФильтраСклада + ВыборкаБезСклада.Количество;
                    КонецЕсли;
                Исключение
                    ОшибкаПодсчетаБезФильтра = Истина;
                КонецПопытки;
            КонецЦикла;
            Статус = Статус + СтрШаблон(
                " Контроль: склад '%1'; документов выбранных типов за период без фильтра по складу: %2.",
                Строка(СкладДляОтбора), КоличествоБезФильтраСклада);
            Если ОшибкаПодсчетаБезФильтра Тогда
                Статус = Статус + " Не удалось подсчитать документы без складского фильтра по одному или нескольким типам.";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуСтатуса(ТекстОшибки)
    Если Статус = Неопределено Или Статус = "" Тогда
        Статус = ТекстОшибки;
    Иначе
        Статус = Статус + " " + ТекстОшибки;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеВиды(Команда)
    Для Каждого СтрокаВида Из ВидыДокументов Цикл
        СтрокаВида.Выбрать = Истина;
    КонецЦикла;
    Статус = "Отмечены все виды документов и справочников.";
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеВиды(Команда)
    Для Каждого СтрокаВида Из ВидыДокументов Цикл
        СтрокаВида.Выбрать = Ложь;
    КонецЦикла;
    Статус = "Отметки со всех видов документов и справочников сняты.";
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеРезультаты(Команда)
    Для Каждого СтрокаРезультата Из РезультатыПоиска Цикл
        СтрокаРезультата.Выбрать = СтрокаРезультата.ДоступенДляОбмена;
    КонецЦикла;
    Статус = "Отмечены все найденные объекты, доступные для обмена.";
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеРезультаты(Команда)
    Для Каждого СтрокаРезультата Из РезультатыПоиска Цикл
        СтрокаРезультата.Выбрать = Ложь;
    КонецЦикла;
    Статус = "Отметки со всех найденных объектов сняты.";
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеВКорзине(Команда)
    Для Каждого СтрокаКорзины Из Корзина Цикл
        СтрокаКорзины.Выбрать = Истина;
    КонецЦикла;
    Статус = "Отмечены все объекты в корзине.";
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеВКорзине(Команда)
    Для Каждого СтрокаКорзины Из Корзина Цикл
        СтрокаКорзины.Выбрать = Ложь;
    КонецЦикла;
    Статус = "Отметки со всех объектов в корзине сняты.";
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВКорзину(Команда)
    ДобавитьВКорзинуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДобавитьВКорзинуНаСервере()
    Добавлено = 0;
    Для Каждого СтрокаРезультата Из РезультатыПоиска Цикл
        Если СтрокаРезультата.ЭтоСвязанный Тогда
            Если Не СтрокаРезультата.Выбрать Или Не СтрокаРезультата.ДоступенДляОбмена Тогда
                Продолжить;
            КонецЕсли;
            ВыбранРодитель = Ложь;
            Для Каждого СтрокаРодителя Из РезультатыПоиска Цикл
                Если СтрокаРодителя.Идентификатор = СтрокаРезультата.РодительИдентификатор Тогда
                    ВыбранРодитель = СтрокаРодителя.Выбрать;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            Если Не ВыбранРодитель Тогда
                Продолжить;
            КонецЕсли;
        ИначеЕсли Не СтрокаРезультата.Выбрать Тогда
            Продолжить;
        КонецЕсли;
        УжеВКорзине = Ложь;
        Для Каждого СтрокаКорзины Из Корзина Цикл
            Если СтрокаКорзины.Идентификатор = СтрокаРезультата.Идентификатор Тогда
                УжеВКорзине = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если УжеВКорзине Тогда
            Продолжить;
        КонецЕсли;
        НоваяСтрока = Корзина.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
        НоваяСтрока.Выбрать = Ложь;
        Добавлено = Добавлено + 1;
    КонецЦикла;
    Статус = СтрШаблон("Добавлено в корзину: %1. Всего в корзине: %2.", Добавлено, Корзина.Количество());
    Если Добавлено > 0 Тогда
        Статус = Статус + " Связанные документы добавляются вместе с отмеченным Отчетом отдела; снимите флажки с ненужных дочерних строк до добавления.";
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзКорзины(Команда)
    УдалитьОтмеченныеИзКорзиныНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьОтмеченныеИзКорзиныНаСервере()
    Для ИндексСтроки = Корзина.Количество() - 1 По 0 Цикл
        Если Корзина[ИндексСтроки].Выбрать Тогда
            Корзина.Удалить(Корзина[ИндексСтроки]);
        КонецЕсли;
    КонецЦикла;
    Статус = СтрШаблон("В корзине: %1.", Корзина.Количество());
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКорзину(Команда)
    Корзина.Очистить();
    Статус = "Корзина очищена.";
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьДляСинхронизации(Команда)
    Если ПустаяСтрока(КлючУзлаДляОбмена) Тогда
        Статус = "Нет узла обмена. Откройте обработку из формы синхронизации.";
        Возврат;
    КонецЕсли;
    Если Корзина.Количество() = 0 Тогда
        Статус = "Корзина пуста.";
        Возврат;
    КонецЕсли;
    Статус = "Регистрирую объекты для следующей синхронизации...";
    Попытка
        ЗарегистрироватьКорзинуНаСервере();
    Исключение
        Статус = "Ошибка регистрации: " + Лев(ОписаниеОшибки(), 220);
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьКорзинуНаСервере()
    УзелДляОбмена = ЗначениеИзСтрокиВнутр(КлючУзлаДляОбмена);
    Если Не ЗначениеЗаполнено(УзелДляОбмена) Тогда
        Статус = "Не удалось определить узел обмена.";
        Возврат;
    КонецЕсли;
    Если Не УзелДопустимДляТиповойСинхронизации(УзелДляОбмена) Тогда
        Статус = "Передача отменена: выбранная ссылка не относится к плану синхронизации через универсальный формат.";
        Возврат;
    КонецЕсли;

    Если УзелДляОбмена = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.ЭтотУзел() Тогда
        Статус = "Передача отменена: текущий узел базы нельзя использовать как узел-получатель. Выберите узел второй базы.";
        Возврат;
    КонецЕсли;

    СсылкиПоТипам = Новый Соответствие;
    Для Каждого СтрокаКорзины Из Корзина Цикл
        СсылкаДокумента = ЗначениеИзСтрокиВнутр(СтрокаКорзины.Идентификатор);
        Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
            Продолжить;
        КонецЕсли;
        ИмяМетаданных = СсылкаДокумента.Метаданные().ПолноеИмя();
        СсылкиТипа = СсылкиПоТипам.Получить(ИмяМетаданных);
        Если СсылкиТипа = Неопределено Тогда
            СсылкиТипа = Новый Массив;
            СсылкиПоТипам.Вставить(ИмяМетаданных, СсылкиТипа);
        КонецЕсли;
        СсылкиТипа.Добавить(СсылкаДокумента);
    КонецЦикла;

    Если СсылкиПоТипам.Количество() = 0 Тогда
        Статус = "В корзине нет корректных ссылок на объекты.";
        Возврат;
    КонецЕсли;

    Зарегистрировано = 0;
    ПропущеноПоСоставу = 0;
    Для Каждого Пара Из СсылкиПоТипам Цикл
        Для Каждого СсылкаДокумента Из Пара.Значение Цикл
            Если УзелДляОбмена.Метаданные().Состав.Найти(СсылкаДокумента.Метаданные()) = Неопределено Тогда
                ПропущеноПоСоставу = ПропущеноПоСоставу + 1;
                Продолжить;
            КонецЕсли;

            Попытка
                ПланыОбмена.ЗарегистрироватьИзменения(УзелДляОбмена, СсылкаДокумента);
            Исключение
                Статус = СтрШаблон("Ошибка регистрации объекта. Уже зарегистрировано: %1. %2",
                    Зарегистрировано, Лев(ОписаниеОшибки(), 190));
                Возврат;
            КонецПопытки;
            Зарегистрировано = Зарегистрировано + 1;
        КонецЦикла;
    КонецЦикла;

    Если Зарегистрировано = 0 Тогда
        Статус = СтрШаблон("Нечего передавать: подходящих объектов в составе узла нет. Пропущено: %1.",
            ПропущеноПоСоставу);
    Иначе
        Статус = СтрШаблон("Зарегистрировано объектов: %1. Пропущено (тип не входит в состав узла): %2. Теперь запустите штатную синхронизацию выбранного узла.",
            Зарегистрировано, ПропущеноПоСоставу);
    КонецЕсли;
КонецПроцедуры
